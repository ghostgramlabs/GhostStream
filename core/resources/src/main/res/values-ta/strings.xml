    <string name="help_line_share_files">வீடியோக்கள், போட்டோக்கள் மற்றும் கோப்புகளைப் பகிருங்கள்.</string>
    <string name="help_line_open_session">Android, iPhone, Windows, Mac அல்லது ஸ்மார்ட் டிவியில் பிரவுசர் மூலம் திறக்கலாம்.</string>
    <string name="help_line_same_network">இரண்டு சாதனங்களும் ஒரே வைஃபை அல்லது ஹாட்ஸ்பாட்டில் இருக்க வேண்டும்.</string>
    <string name="help_line_multiple_browse">ஒரே நேரத்தில் பல சாதனங்கள் இணைக்கப்படலாம்.</string>
    <string name="help_line_video_direct">பெரும்பாலான வீடியோக்கள் பிரவுசரிலேயே நேரடியாக ஓடும்.</string>
    <string name="help_line_video_temporary">சில வீடியோக்களுக்குச் சீரான பிளேபேக்கிற்காகத் தற்காலிக மாற்றம் தேவைப்படலாம்.</string>
    <string name="help_line_video_original">அசல் கோப்பு மாறாது, அது பாதுகாப்பாக இருக்கும்.</string>
    <string name="help_line_receive_upload">அனுமதி வழங்கப்பட்டால் மற்றவர்கள் உங்களுக்குக் கோப்புகளை அனுப்பலாம்.</string>
    <string name="help_line_receive_approval">ஒவ்வொரு முறையும் கோப்புகள் வரும்போது அனுமதி கேட்கும்.</string>
    <string name="help_line_receive_history">பெறப்பட்ட கோப்புகள் சாதனத்தில் சேமிக்கப்படும்.</string>
