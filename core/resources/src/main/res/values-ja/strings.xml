    <string name="onboarding_title">ストリーミング &amp; ファイル共有</string>
    <string name="onboarding_subtitle">お使いのスマホを、テレビやPC、タブレットからアクセスできる自分だけのローカルハブに。</string>
    <string name="onboarding_page_1_title">近くのデバイスですぐに視聴</string>
