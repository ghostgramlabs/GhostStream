    <string name="help_title">Aiuto</string>
    <string name="help_about_title">Informazioni su DirectServe</string>
    <string name="help_about_1">DirectServe consente ai dispositivi vicini di aprire i file condivisi nel browser senza cloud o account.</string>
    <string name="help_about_2">È compatibile con ogni dispositivo dotato di Wi-Fi/hotspot e browser.</string>
    <string name="help_about_3">Niente cloud. Niente account. Niente Internet.</string>
    <string name="help_section_what_you_can_do">Cosa puoi fare</string>
    <string name="help_section_video_playback">Riproduzione video</string>
    <string name="help_section_receiving_files">Ricezione file</string>
    <string name="help_section_multiple_devices">Più dispositivi</string>
    <string name="help_section_good_to_know">Utile da sapere</string>
    <string name="help_section_quick_flow">Guida rapida</string>
    <string name="help_line_share_files">Condividi video, foto, musica, documenti e cartelle dal tuo telefono.</string>
    <string name="help_line_open_session">Apri la sessione nel browser su Android, iPhone, iPad, Windows, Mac, Linux, tablet e smart TV.</string>
    <string name="help_line_same_network">Qualsiasi dispositivo sulla stessa rete locale (Wi-Fi o hotspot) può connettersi.</string>
    <string name="help_line_multiple_browse">Mantieni una sessione aperta mentre più dispositivi navigano contemporaneamente.</string>
    <string name="help_line_video_direct">La maggior parte dei video può essere riprodotta direttamente nel browser.</string>
    <string name="help_line_video_temporary">Alcuni video potrebbero richiedere una versione temporanea per una riproduzione più fluida.</string>
    <string name="help_line_video_original">Il file originale resta sul tuo telefono; il processo di preparazione non lo modifica.</string>
    <string name="help_line_receive_upload">Gli altri dispositivi possono inviarti file via web se consenti i caricamenti.</string>
    <string name="help_line_receive_approval">Se l\'approvazione è attiva, vedrai una richiesta prima di accettare i file.</string>
    <string name="help_line_receive_history">I file ricevuti vengono salvati sul dispositivo e compaiono nella cronologia.</string>
    <string name="help_line_multi_connect">Più di un dispositivo può connettersi alla stessa sessione.</string>
    <string name="help_line_multi_live">La schermata della sessione live mostra i dispositivi connessi, l\'attività e gli indirizzi IP.</string>
    <string name="help_line_multi_controls">Puoi bloccare dispositivi, disconnettere tutti o proteggere la sessione con un PIN.</string>
    <string name="help_line_wifi_hotspot">Entrambi i dispositivi devono trovarsi sulla stessa rete Wi-Fi o sul tuo hotspot.</string>
    <string name="help_line_public_wifi">Il Wi-Fi pubblico a volte blocca il traffico tra dispositivi; in tal caso l\'hotspot è la soluzione migliore.</string>
    <string name="help_line_downloads_disabled">Se i download sono disattivati nelle impostazioni, i pulsanti di download nel browser verranno nascosti.</string>
    <string name="help_line_flow_1">1. Aggiungi file o una cartella.</string>
    <string name="help_line_flow_2">2. Avvia la sessione.</string>
    <string name="help_line_flow_3">3. Apri il link o scansiona il QR code sull\'altro dispositivo.</string>
    <string name="help_line_flow_4">4. Sfoglia, riproduci o carica file in base ai permessi impostati.</string>

