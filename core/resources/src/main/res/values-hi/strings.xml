    <string name="help_line_share_files">अपने फ़ोन से वीडियो, फ़ोटो, म्यूज़िक, दस्तावेज़ और फ़ोल्डर शेयर करें।</string>
    <string name="help_line_open_session">Android फ़ोन, iPhone, iPad, Windows लैपटॉप, Mac, Linux, टैबलेट, डेस्कटॉप और कई स्मार्ट TV के ब्राउज़र में सेशन खोलें।</string>
    <string name="help_line_same_network">वाई-फ़ाई या हॉटस्पॉट और ब्राउज़र वाला कोई भी डिवाइस उसी लोकल नेटवर्क पर कनेक्ट हो सकता है।</string>
    <string name="help_line_multiple_browse">एक शेयर को खुला रखें जबकि कई डिवाइसेज एक साथ ब्राउज़ करें।</string>
    <string name="help_line_video_direct">ज़्यादातर वीडियो ब्राउज़र में सीधे चल सकते हैं।</string>
    <string name="help_line_video_temporary">कुछ वीडियो को कुछ डिवाइसेज पर बेहतर प्लेबैक के लिए एक अस्थायी ब्राउज़र-रेडी वर्ज़न की ज़रूरत होती है।</string>
    <string name="help_line_video_original">ओरिजिनल फ़ाइल आपके फ़ोन पर ही रहती है, और प्लेबैक की तैयारी आपकी सोर्स फ़ाइल को नहीं बदलती है।</string>
    <string name="help_line_receive_upload">अपलोड की अनुमति होने पर दूसरे डिवाइसेज वेब व्यू के ज़रिए आपके फ़ोन पर फ़ाइलें भेज सकते हैं।</string>
    <string name="help_line_receive_approval">यदि अपलोड अप्रूवल चालू है, तो फ़ाइलें स्वीकार करने से पहले आपको एक रिक्वेस्ट दिखाई देगी।</string>
    <string name="help_line_receive_history">रिसीव की गई फ़ाइलें आपके डिवाइस पर सेव की जाती हैं और आपके इतिहास में दिखाई दे सकती हैं।</string>
    <string name="help_line_multi_connect">एक ही सेशन से एक से ज़्यादा डिवाइस कनेक्ट हो सकते हैं।</string>
    <string name="help_line_multi_live">लाइव सेशन स्क्रीन कनेक्टेड डिवाइसेज, एक्टिविटी और जनरेट किए गए डिवाइस के नाम IP एड्रेस के साथ दिखाती है।</string>
    <string name="help_line_multi_controls">आप डिवाइसेज को ब्लॉक कर सकते हैं, सबको डिस्कनेक्ट कर सकते हैं, या सेशन को PIN से सुरक्षित कर सकते हैं।</string>
    <string name="help_line_wifi_hotspot">दोनों डिवाइसेज एक ही वाई-फ़ाई नेटवर्क या आपके फ़ोन हॉटस्पॉट पर होने चाहिए।</string>
    <string name="help_line_public_wifi">पब्लिक वाई-फ़ाई कभी-कभी डिवाइस-टू-डिवाइस ट्रैफ़िक को ब्लॉक कर देता है, इसलिए हॉटस्पॉट अक्सर सबसे अच्छा विकल्प होता है।</string>
    <string name="help_line_downloads_disabled">यदि सेटिंग्स में डाउनलोड डिसेबल हैं, तो वेब UI डाउनलोड बटन्स को पूरी तरह से छिपा देता है।</string>
    <string name="help_line_flow_1">1. फ़ाइलें या फ़ोल्डर जोड़ें।</string>
