    <string name="help_title">Ayuda</string>
    <string name="help_about_title">Sobre DirectServe</string>
    <string name="help_about_1">DirectServe permite que dispositivos cercanos abran tus archivos en un navegador sin usar la nube ni crear cuentas.</string>
    <string name="help_about_2">Es compatible con cualquier dispositivo que tenga Wi-Fi y navegador.</string>
    <string name="help_about_3">Sin nubes. Sin cuentas. Sin internet.</string>
    <string name="help_section_what_you_can_do">Qué puedes hacer</string>
    <string name="help_section_video_playback">Reproducción de video</string>
    <string name="help_section_receiving_files">Recibir archivos</string>
    <string name="help_section_multiple_devices">Varios dispositivos</string>
    <string name="help_section_good_to_know">Datos útiles</string>
    <string name="help_section_quick_flow">Guía rápida</string>
    <string name="help_line_share_files">Comparte videos, fotos, música, documentos y carpetas desde tu móvil.</string>
    <string name="help_line_open_session">Abre la sesión en navegadores de Android, iPhone, iPad, Windows, Mac, Linux, tablets y smart TVs.</string>
    <string name="help_line_same_network">Cualquier dispositivo con Wi-Fi o hotspot puede conectarse en la misma red local.</string>
    <string name="help_line_multiple_browse">Mantén una sesión abierta mientras varios dispositivos navegan a la vez.</string>
    <string name="help_line_video_direct">La mayoría de los videos se reproducen directo en el navegador.</string>
    <string name="help_line_video_temporary">Algunos videos necesitan una versión temporal optimizada para reproducirse mejor en ciertos dispositivos.</string>
    <string name="help_line_video_original">El archivo original se queda en tu teléfono; el proceso de preparación no lo reemplaza.</string>
    <string name="help_line_receive_upload">Otros dispositivos pueden enviarte archivos a través de la web si permites las subidas.</string>
    <string name="help_line_receive_approval">Si activas la aprobación, verás una solicitud antes de aceptar los archivos.</string>
    <string name="help_line_receive_history">Los archivos recibidos se guardan en tu dispositivo y aparecen en el historial.</string>
    <string name="help_line_multi_connect">Más de un dispositivo puede conectarse a la misma sesión.</string>
    <string name="help_line_multi_live">La pantalla de sesión en vivo muestra los dispositivos conectados, su actividad y direcciones IP.</string>
    <string name="help_line_multi_controls">Puedes bloquear dispositivos, desconectar a todos o proteger la sesión con un PIN.</string>
    <string name="help_line_wifi_hotspot">Ambos dispositivos deben estar en el mismo Wi-Fi o en tu punto de acceso.</string>
    <string name="help_line_public_wifi">El Wi-Fi público a veces bloquea el tráfico entre dispositivos; el hotspot suele ser la mejor alternativa.</string>
    <string name="help_line_downloads_disabled">Si desactivas las descargas en Ajustes, el navegador ocultará los botones de descarga.</string>
    <string name="help_line_flow_1">1. Añade archivos o una carpeta.</string>
    <string name="help_line_flow_2">2. Inicia la sesión.</string>
    <string name="help_line_flow_3">3. Abre el enlace o escanea el QR en el otro dispositivo.</string>
    <string name="help_line_flow_4">4. Navega, reproduce o sube archivos según lo permitido.</string>

