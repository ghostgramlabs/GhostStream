    <string name="onboarding_title">Streaming direct et partage de fichiers</string>
    <string name="onboarding_subtitle">Transformez votre téléphone en un hub local privé accessible depuis une TV, un ordinateur ou une tablette.</string>
    <string name="onboarding_page_1_title">Regardez sur les appareils à proximité</string>
    <string name="onboarding_page_1_description">Ouvrez instantanément vos vidéos, photos et musiques sur d\'autres appareils sans avoir à les télécharger ailleurs.</string>
    <string name="onboarding_page_2_title">Compatible avec tous les écrans</string>
    <string name="onboarding_page_2_description">Diffusez sur TV, Mac, Windows, iPhone, Android ou tout appareil disposant d\'un navigateur web.</string>
    <string name="onboarding_page_3_title">Connexion via navigateur</string>
