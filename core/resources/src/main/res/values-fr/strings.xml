    <string name="onboarding_page_4_title">Partage bidirectionnel</string>
    <string name="onboarding_page_4_description">Envoyez des fichiers et récupérez-en depuis les appareils connectés au cours de la même session.</string>
    <string name="onboarding_page_5_title">Sans Internet</string>
    <string name="onboarding_page_5_description">Tout passe par votre réseau Wi-Fi ou votre point d\'accès mobile. C\'est rapide, fiable et local.</string>
