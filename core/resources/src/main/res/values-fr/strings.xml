    <string name="help_title">Aide</string>
    <string name="help_about_title">À propos de DirectServe</string>
    <string name="help_about_1">DirectServe permet aux appareils à proximité d\'ouvrir vos fichiers partagés dans un navigateur sans avoir besoin de cloud ou de compte.</string>
    <string name="help_about_2">C\'est universel : n\'importe quel appareil avec Wi-Fi et un navigateur peut se connecter.</string>
    <string name="help_about_3">Pas de cloud. Pas de compte. Pas besoin d\'Internet.</string>
    <string name="help_section_what_you_can_do">Ce que vous pouvez faire</string>
    <string name="help_section_video_playback">Lecture vidéo</string>
    <string name="help_section_receiving_files">Réception de fichiers</string>
    <string name="help_section_multiple_devices">Appareils multiples</string>
    <string name="help_section_good_to_know">Bon à savoir</string>
    <string name="help_section_quick_flow">Guide rapide</string>
    <string name="help_line_share_files">Partagez vidéos, photos, musique, documents et dossiers depuis votre téléphone.</string>
    <string name="help_line_open_session">Ouvrez la session sur Android, iPhone, iPad, Windows, Mac, Linux, tablettes et Smart TV.</string>
    <string name="help_line_same_network">Tout appareil sur le même réseau local (Wi-Fi ou point d\'accès) peut se connecter.</string>
    <string name="help_line_multiple_browse">Plusieurs appareils peuvent parcourir vos fichiers en même temps.</string>
    <string name="help_line_video_direct">La plupart des vidéos se lisent directement dans le navigateur.</string>
    <string name="help_line_video_temporary">Certaines vidéos peuvent nécessiter une préparation temporaire pour une lecture plus fluide.</string>
    <string name="help_line_video_original">Le fichier original reste intact sur votre téléphone.</string>
    <string name="help_line_receive_upload">Les autres appareils peuvent vous envoyer des fichiers via l\'interface web si vous l\'autorisez.</string>
    <string name="help_line_receive_approval">Si l\'approbation est activée, vous devrez valider chaque transfert entrant.</string>
    <string name="help_line_receive_history">Les fichiers reçus sont enregistrés dans votre historique local.</string>
    <string name="help_line_multi_connect">Plusieurs appareils peuvent se connecter simultanément.</string>
    <string name="help_line_multi_live">L\'écran de session affiche l\'activité en temps réel et les appareils connectés.</string>
    <string name="help_line_multi_controls">Vous pouvez bloquer des appareils ou protéger la session par un code PIN.</string>
    <string name="help_line_wifi_hotspot">Les deux appareils doivent être sur le même Wi-Fi ou point d\'accès mobile.</string>
    <string name="help_line_public_wifi">Les Wi-Fi publics bloquent souvent les connexions entre appareils ; le point d\'accès est alors préférable.</string>
    <string name="help_line_downloads_disabled">Si les téléchargements sont désactivés, les boutons de téléchargement seront masqués sur le web.</string>
    <string name="help_line_flow_1">1. Ajoutez des fichiers ou un dossier.</string>
    <string name="help_line_flow_2">2. Démarrez la session.</string>
    <string name="help_line_flow_3">3. Ouvrez le lien ou scannez le QR code sur l\'autre appareil.</string>
    <string name="help_line_flow_4">4. Parcourez, lisez ou envoyez des fichiers.</string>

